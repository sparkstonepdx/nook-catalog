{
  "id": "subduction",
  "name": "Subduction",
  "description": "Sync server for Automerge apps: documents and their history, over WebSockets, signed by a key kept with its data. Its site's page shows the address, peer id and Keyhive contact card apps need.",
  "homepage": "https://github.com/sparkstonepdx/nook-catalog/tree/main/packages/subduction",
  "license": "MIT OR Apache-2.0",
  "kind": "web",
  "site": "subduction",
  "memory": "700M",
  "binary": "subduction",
  "env": [
    {
      "key": "RUST_LOG",
      "desc": "Log level: error, warn, info, debug or trace",
      "default": "info"
    }
  ],
  "files": {
    "run": "#!/bin/sh\nexec ./subduction\n"
  },
  "source": {
    "github": "sparkstonepdx/nook-catalog",
    "tagPrefix": "subduction-",
    "assets": {
      "amd64": "^subduction_.*_linux_amd64\\.tar\\.gz$",
      "arm64": "^subduction_.*_linux_arm64\\.tar\\.gz$"
    },
    "format": "tar.gz"
  },
  "health": "/health"
}
