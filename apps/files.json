{
  "id": "files",
  "name": "Files",
  "description": "Public file storage for your apps: CI uploads APKs, installers and release downloads with NOOK_TOKEN, anyone downloads from a plain link that resumes.",
  "homepage": "https://github.com/sparkstonepdx/nook-catalog/tree/main/packages/files",
  "license": "MIT",
  "kind": "web",
  "site": "files",
  "health": "/health",
  "memory": "128M",
  "binary": "files",
  "auth": "nook-token",
  "open": ["/f/*", "/health"],
  "env": [
    { "key": "FILES_MAX_MB", "desc": "Largest upload in MB, up to 2047", "default": "2047" },
    { "key": "FILES_URL", "desc": "Public URL of this site, for the links uploads return", "default": "https://{site_host}" }
  ],
  "files": { "run": "#!/bin/sh\nexec ./files\n" },
  "source": {
    "github": "sparkstonepdx/nook-catalog",
    "tagPrefix": "files-",
    "assets": { "amd64": "^files_.*_linux_amd64\\.tar\\.gz$", "arm64": "^files_.*_linux_arm64\\.tar\\.gz$" },
    "format": "tar.gz"
  }
}
